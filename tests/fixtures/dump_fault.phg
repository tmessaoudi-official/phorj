package Main;

import Core.Output;
import Core.Secret;
import Core.Runtime.Entry;
import Core.Runtime.EntryKind;

function compute(int n): int {
    int doubled = n * 2;
    Secret<string> token = new Secret("hunter2");
    List<int> xs = [10, 20];
    return xs[n] + doubled;
}

#[Entry(kind: EntryKind.Cli)]

function main(): void {
    Output.printLine("{compute(5)}");
}
