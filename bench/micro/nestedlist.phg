package Main;

import Core.Output;
import Core.Runtime;
import Core.Runtime.Entry;

// Microbench: the ERASED FORM of `namedtuplefield` — the SAME workload written as a list of
// positional lists. This is a CONTROL, deliberately paired: DEC-504's named tuple erases to exactly
// this shape before every backend, so a ratio gap between the two rows would be the named-tuple
// sugar costing something at runtime, and equal ratios say it costs nothing.
//
// Read the two rows together or not at all. `namedtuplefield` alone cannot separate "named tuples
// are slow" from "nested list indexing is slow" — and it is the second, which predates DEC-504.
//
// Same data, same index sequence, same checksum as namedtuplefield: `rows[idx][1]` is `.bp` and
// `rows[idx][0]` is `.tier`, because a field name resolves to its written position.
function bench(int iters): int {
    List<List<int>> rows = [[1, 3], [2, 1], [3, 4], [4, 1], [5, 5], [6, 9], [7, 2], [8, 6]];
    mutable int acc = 0;
    mutable int i = 0;
    while (i < iters) {
        int idx = (i + acc) % 8;
        acc = acc + rows[idx][1] * 2 - rows[idx][0];
        i = i + 1;
    }
    return acc;
}

#[Entry(kind: EntryKind.Cli)]
function main(): void {
    int iters = 5000000;
    int warm = bench(iters);
    int guard = warm - warm;
    int t = Runtime.monotonicNanos();
    int acc = bench(iters);
    int d = Runtime.monotonicNanos() - t;
    Output.printLine("nestedlist\t{d + guard}\t{acc}");
}
