package Main;

import Core.Output;
import Core.Runtime;
import Core.Runtime.Entry;

// Microbench: `??` with a plain default — the control for `throwexpr` (DEC-532): the same loop with nothing to throw.
function orZero(int? n): int {
    return n ?? 0;
}

function bench(int iters): int {
    mutable int acc = 0;
    mutable int i = 0;
    while (i < iters) {
        acc = acc + orZero(i % 100);
        i = i + 1;
    }
    return acc;
}

#[Entry(kind: EntryKind.Cli)]
function main(): void {
    int iters = 3000000;
    int warm = bench(iters);
    int guard = warm - warm;
    int t = Runtime.monotonicNanos();
    mutable int acc = 0;
    acc = bench(iters);
    int d = Runtime.monotonicNanos() - t;
    Output.printLine("coalesceor\t{d + guard}\t{acc}");
}
