#!/usr/bin/env bash
# Phorj pre-push gate — the byte-identity SPINE check (developer, 2026-07-03 speed split).
#
# Pre-commit runs the fast Rust-only gate (fast tier: run == run --tree-walker parity + every unit/integration
# test EXCEPT the two heavy sweeps). THIS hook runs the FULL suite — including those two sweeps
# (`every_repo_phg_formats_idempotently_and_safely` + `shipped_manual_example_runs_on_both_backends`)
# — plus the PHP-oracle differential against the 8.5 transpile floor before anything is published:
# with PHORJ_REQUIRE_PHP=1 a missing php FAILS the run (never silently skips), so a push can never
# bypass the spine check. `jit` is a DEFAULT feature (the explicit flag is a harmless no-op). `clippy`
# lives HERE now (moved off pre-commit 2026-07-08 — a lint is zero correctness-risk and batches
# cleanly at this ~10-20-commit boundary); both feature configs are linted. cargo-nextest is preferred
# with a `cargo test` fallback — zero hard dependency.
set -euo pipefail

# git feeds the pushed-ref list on stdin; we gate the whole push, not per-ref, so drain it.
cat >/dev/null || true

# The toolchain lives outside the default PATH on this machine; prepend it only if cargo is
# not already reachable (keeps the hook working under git's reduced environment).
command -v cargo >/dev/null 2>&1 || export PATH="/stack/tools/cargo/bin:$PATH"

# Build NON-incrementally for the gate. This box links with `mold` (machine-local, gitignored
# config), and `mold` + rustc incremental compilation intermittently fail to link with
# `undefined symbol: anon.<hash>.llvm.<n>` referencing stale `*.rcgu.o` incremental codegen units —
# a known mold+incremental interaction, triggered whenever an earlier build was interrupted and left
# stale units behind. It is NOT a code error (the same tree links + tests clean non-incrementally).
# The pre-push gate is a full-suite build where incremental buys little, so disabling it here makes
# the gate robust against the corruption without slowing the fast pre-commit tier (which keeps
# incremental). Root cause: stale incremental units; fix: from-scratch codegen (no stale units).
export CARGO_INCREMENTAL=0

# Gate against the 8.5 transpile floor (NOT the 8.6-dev php on PATH). A missing php FAILS.
# The oracle path is configured in scripts/toolchain.env (edit there when the stack php version
# changes); resolve it via the repo root so this works whichever way the hook is invoked.
_gate_root="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
# shellcheck source=/dev/null
[[ -f "$_gate_root/scripts/toolchain.env" ]] && source "$_gate_root/scripts/toolchain.env"
# NO fallback pin here — toolchain.env is the ONLY resolver (it globs php-8.5.* newest-first and
# capability-checks bcmath). This line used to read `${PHORJ_PHP:-…/php-8.5.8/bin/php}`, a second
# source of truth that went stale when the stack moved to 8.5.9: the hook then handed the suite a
# path that does not exist, and the failure surfaced as three opaque `php required (PHORJ_REQUIRE_PHP=1)
# but not found` asserts in tests/attribute_transpile.rs instead of toolchain.env's actionable
# warning (observed 2026-08-20 on a docs-only push). Fail LOUD and early instead — an unresolvable
# oracle means the byte-identity spine cannot be gated, which must never look like a test bug.
# scripts/validate-infra.sh enforces the no-pin rule mechanically.
if [[ -z "${PHORJ_PHP:-}" ]]; then
  echo "[pre-push] FATAL: no PHP 8.5 build with bcmath resolved — see the toolchain.env warning above." >&2
  echo "[pre-push] The PHP leg of the byte-identity spine cannot be gated without it." >&2
  echo "[pre-push] Fix: install a php-8.5.* under /stack/tools/phpbrew/php/, or export PHORJ_PHP=<path>." >&2
  exit 1
fi
export PHORJ_PHP
export PHORJ_REQUIRE_PHP=1
echo "[pre-push] PHP oracle: $PHORJ_PHP"

echo "[pre-push] cargo fmt --check"
cargo fmt --check

# File-size gate (Invariant 13 — developer-ruled 2026-07-20). Ratchet: new files capped at 500,
# the pre-existing breaches grandfathered in scripts/size-baseline.txt (72 rows today; may only shrink), soft
# warn at 300. Cheap (line counts) — runs early. Detail: scripts/size-gate.sh.
echo "[pre-push] size-gate (Invariant 13 file-size ratchet)"
bash "$_gate_root/scripts/size-gate.sh"

# Invariant 17's 100% RULE + Invariant 9, made mechanical: the LSP/editor/example/diagnostic surface
# may not shrink. Cheap (greps, no build). Detail + rationale: scripts/surface-ratchet.sh.
echo "[pre-push] surface-ratchet (Invariant 17 coverage floors)"
bash "$_gate_root/scripts/surface-ratchet.sh"

# Infra syntax gate (DEC-388). `bash -n` over every tracked shell script + the git hooks, plus a
# parse of every tracked YAML and JSON. This is the Coverage evidence global Rule 7 REQUIRES for infra
# changes — wired here so it is produced mechanically rather than hand-rolled per session. Cheap
# (syntax only, no builds). shellcheck/yamllint/hadolint are absent on this box and are reported as
# LOUD SKIPS, never as passes. Detail: scripts/validate-infra.sh.
echo "[pre-push] validate-infra (Rule 7 infra syntax gate)"
bash "$_gate_root/scripts/validate-infra.sh" --quiet

# wasm32 compile gate. The local gate builds ONLY for the 64-bit host, so a 32-bit-only error is
# invisible here: `INJECTED_SPAN_BASE = 1 << 32` overflows const-eval on wasm32 and broke the playground
# workflow for six consecutive runs while every local step stayed green. `cargo check` for the
# playground's target closes that blind spot. Detail: scripts/wasm-check.sh.
echo "[pre-push] wasm-check (the playground target the host build cannot see)"
bash "$_gate_root/scripts/wasm-check.sh"

# Documentation guards (DEC-362). Doc rot was MEASURED as this project's dominant defect class, and
# every instance so far was found by hand — a dangling `src/` path, a DEC id with no register row, a
# diagnostic code claimed as shipped that no longer exists (`E-RETIRED-FORIN`). Four mechanical checks
# (paths / DEC rows / bare SHAs / diagnostic codes); G2 is hard, the other three are ratcheted against
# scripts/doc-guards-baseline.txt like the size gate. Cheap (greps, no builds). Detail:
# scripts/doc-guards.sh.
echo "[pre-push] doc-guards (DEC-362 documentation ratchet)"
bash "$_gate_root/scripts/doc-guards.sh"

# The G-8 ratchet's OWN behaviour tests (DEC-423). The gate below is the only thing between a perf
# regression and master, and it had no tests — which is how it stayed DARK for weeks without anyone
# noticing. These drive it through its JSON seam: no docker, no php, no timing, ~1s, fully
# deterministic. If the gate stops blocking, THIS fails first.
echo "[pre-push] test-microbench-gate (the ratchet's own behaviour tests)"
bash "$_gate_root/scripts/test-microbench-gate.sh"

# Same reasoning, same failure already observed once: validate-infra.sh HAD a behaviour suite
# (scripts/test-validate-infra.sh) that no gate ever ran, so a check could go dark unnoticed — and
# one promptly did (the 2026-08-20 php-pin check shipped scanning zero files in that suite's own
# fixture while printing a pass). ~1s, no builds.
echo "[pre-push] test-validate-infra (the infra gate's own behaviour tests)"
bash "$_gate_root/scripts/test-validate-infra.sh"

# Third instance of the SAME failure, and the worst so far: surface-ratchet.sh shipped 2026-08-08
# with no behaviour suite, and had been measuring the wrong thing from day one — `grep --include`
# matches the BASENAME, not the path, so 101 test files in `tests/` DIRECTORIES were invisible. It
# reported 27% coverage against a true 82%, and froze its floor at 83, leaving 169 codes'
# coverage unprotected: deleting the only test asserting a code did not trip the gate.
# These cases re-run that sabotage proof (which was done by HAND, the state that let the bug live).
# ~2s, no builds, no network.
echo "[pre-push] test-surface-ratchet (the coverage gate's own behaviour tests)"
bash "$_gate_root/scripts/test-surface-ratchet.sh"

# Lint the two ends of the feature spectrum (developer-ruled 2026-07-16 — the standing gate is
# ALL-FEATURES). `--all-features` compiles + lints EVERY shipped surface (jit, database, database-postgres,
# database-mysql, mail, http-client) — the old `--features jit`-only gate never touched those files, hiding
# real clippy lints (caught: http_client.rs, db/mysql.rs collapsible-ifs). `--no-default-features`
# lints the minimal/jit-off path. Together they bound every config a change can land in.
echo "[pre-push] cargo clippy --all-targets --no-default-features -- -D warnings"
cargo clippy --all-targets --no-default-features -- -D warnings
echo "[pre-push] cargo clippy --all-targets --all-features -- -D warnings"
cargo clippy --all-targets --all-features -- -D warnings

# FULL suite under --all-features + the PHP oracle. `--all-features` SUBSUMES the old separate
# `--features database` step (database is now in the set) and adds the previously-ungated http-client/mail/postgres/
# mysql surfaces. The live DB/mail/http round-trips self-skip when their `PHORJ_*_TEST_DSN` / server env
# is absent (skip-loud, never silently green), so the gate needs no live servers.
if cargo nextest --version >/dev/null 2>&1; then
  echo "[pre-push] cargo nextest run --all-features (FULL suite + PHP oracle, 8.5 floor)"
  cargo nextest run --all-features --status-level fail
  echo "[pre-push] cargo test --doc --all-features"
  cargo test --doc --all-features --quiet
else
  echo "[pre-push] cargo test --all-features (nextest absent — fallback, FULL suite + PHP oracle)"
  cargo test --all-features --quiet
fi

# Release build gate (developer-ruled 2026-07-20; CLAUDE.md "build release after each feature").
# Catches release-profile-only breakage (a debug-only cfg, an opt-level panic) that the dev/test
# profiles above would pass green. Runs after the suite so a red test fails faster/cheaper first.
echo "[pre-push] cargo build --release"
cargo build --release

echo "[pre-push] microbench-gate (G-8 mandate ratchet — no WIN->LOSS flip, output-identity holds)"
# Self-skips (exit 0) if docker or the release binary is absent — a push is never wedged by missing
# infra. Blocks (exit 1) only on a WIN->LOSS flip (a feature that beat release-php now loses) or a
# VM-vs-php output-identity break — both load-insensitive. VM-perf regression is gated robustly by
# perf-gate.sh (same-process tree÷VM). Ratchet: after the JIT lands a WIN, run
# `bash scripts/microbench-gate.sh --emit` so the flip check protects it.
bash "$_gate_root/scripts/microbench-gate.sh"

echo "[pre-push] OK"
