# shellcheck shell=bash
# Phorj toolchain / gate-oracle configuration — EDIT HERE.
#
# Single source of truth for the machine-specific tool paths the quality gate needs.
# Sourced by scripts/git-hooks/pre-push, and by any manual gate run:
#     source scripts/toolchain.env && cargo test --workspace
#
# PHORJ_PHP — the PHP byte-identity oracle. MUST be the 8.5 transpile-floor build, NOT the
# 8.6-dev `php` on PATH (that build is too permissive to gate against — see CLAUDE.md). When the
# stack reloads and the phpbrew php version changes, update the version in the path below and
# nothing else needs to move.
#
# An explicit `PHORJ_PHP=… ` in the environment still wins over this default (the `:-` keeps the
# override working), so CI or a one-off run can point elsewhere without editing this file.
#
# MUST `export` — the documented usage is `source scripts/toolchain.env && cargo test`, and cargo
# spawns the test binary as a CHILD process: an unexported shell var does NOT reach it, so
# `php_bin()` would silently fall back to the on-PATH `php` (e.g. /bin/php 8.5.4, which lacks the
# static bcmath the transpiled `decimal` oracle needs) and gate against the WRONG build. The pre-push
# hook re-exports defensively, but manual runs rely on this line. (Root-caused 2026-07-09: a decimal
# conformance `bcmul()` "failure" that was really the wrong php.)
#
# Container-aware (DEC-331 D10d): the dev's stack path is the primary; a fresh remote container
# (where that path is absent) falls back to an on-PATH `php8.5`. An explicit `PHORJ_PHP=…` in the
# environment always wins over both (a from-source build points here for a one-off run). If NONE
# resolve to an executable, warn LOUDLY — never silently gate against a wrong php.
# The candidate is GLOBBED, not pinned to one patch version, and then CAPABILITY-CHECKED.
#
# Root-caused 2026-08-18, and it is the SECOND time this exact class bit the gate. The list used to
# name `php-8.5.8` literally. The stack moved to php-8.5.9, that path stopped existing, and the
# loop fell through to `php8.5` on PATH — /bin/php8.5, an 8.5.4 build with NO bcmath. The gate then
# ran the transpiled PHP under an interpreter that cannot execute it, and reported
# `conformance_single_file_golden` + `all_examples_transpile_and_match_php` as FAILING CODE.
# Demonstrated: the same transpiled decimal.phg gives `Call to undefined function bcmul()` (exit
# 255) under /bin/php8.5, and output byte-identical to `phg run` (exit 0) under php-8.5.9.
#
# Two changes, both aimed at the cause rather than the symptom:
#   1. Glob `php-8.5.*` newest-first, so a stack patch bump does not silently break the pin again.
#   2. Require `bcmath`. The transpiler emits ~42 bc*() calls, so a PHP without bcmath is not a
#      "slightly wrong" oracle — it cannot run the output at all. Version number was never the real
#      requirement; the extension is. A candidate that lacks it is REJECTED, not used.
# A build that resolves but fails the capability check warns LOUDLY, because the documented rule
# here is: never silently gate against the wrong php.
# An inherited PHORJ_PHP still WINS — but it is capability-checked like any other candidate
# (refines DEC-331 D10d's "an explicit override always wins"). A long-lived terminal that sourced
# an OLDER copy of this file still exports the patch version that was current then; after a stack
# bump that path no longer exists, and trusting it silently makes the gate fail with an opaque
# "php not found" from the test guard. A stale export is an accident, not an instruction — and the
# standing rule here is never to gate against a php we have not checked. Warn LOUDLY, resolve fresh.
if [ -n "${PHORJ_PHP:-}" ]; then
  if [ ! -x "${PHORJ_PHP}" ] || ! "${PHORJ_PHP}" -m 2>/dev/null | grep -qx 'bcmath'; then
    echo "toolchain.env warn: inherited PHORJ_PHP='${PHORJ_PHP}' is not an executable php with" \
         "bcmath — IGNORING it and resolving fresh (a stale export from an older shell?)." >&2
    PHORJ_PHP=""
  fi
fi
if [ -z "${PHORJ_PHP:-}" ]; then
  for _phorj_php_cand in \
    $(ls -1d /stack/tools/phpbrew/php/php-8.5.*/bin/php 2>/dev/null | sort -Vr) \
    "$(command -v php8.5 2>/dev/null || true)"; do
    [ -n "${_phorj_php_cand}" ] && [ -x "${_phorj_php_cand}" ] || continue
    if "${_phorj_php_cand}" -m 2>/dev/null | grep -qx 'bcmath'; then
      PHORJ_PHP="${_phorj_php_cand}"
      break
    fi
    echo "toolchain.env: skipping '${_phorj_php_cand}' — no bcmath, cannot run transpiled output" >&2
  done
  unset _phorj_php_cand
fi
if [ -z "${PHORJ_PHP:-}" ]; then
  echo "toolchain.env warn: no PHP 8.5 build with bcmath found — the byte-identity oracle is" \
       "unavailable here, so a green gate would NOT mean the PHP leg passed. Install one or set" \
       "PHORJ_PHP explicitly before gating." >&2
fi
export PHORJ_PHP="${PHORJ_PHP:-}"

# Rust toolchain is pinned separately by rust-toolchain.toml (rustup reads it automatically);
# it is intentionally NOT duplicated here to avoid a second source of truth.
