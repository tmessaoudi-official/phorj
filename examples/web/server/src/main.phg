// The served application — routing over the `Core.Http` value model.
//
// This file is the CLI entry: it drives the whole pipe (parse → route → dispatch → serialize) over
// canned wire requests, with no socket, so the application stays byte-identity-gated on both
// backends AND through real PHP. The SERVED form is `../serve.phg`, a separate compilation unit
// whose `Web` entry hands the same handler to `Http.serve` (DEC-331 D5). They are split because
// `phg transpile` refuses any file that calls `Http.serve` (`E-TRANSPILE-SERVE`, Invariant 14
// tier 2) — keeping that call out of this unit is exactly what preserves the PHP leg below.
//
// `server.php` is the `php -S` front-controller that calls the SAME transpiled handler; see
// `../README.md` for running both.
package Main;

import Core.Output;
import Core.Bytes;
import Core.String;
import Core.Http.Request;
import Acme.Routing;
import Core.Runtime.Entry;
import Core.Runtime.EntryKind;

// bytes in → bytes out, the shape a server actually needs: parse, route, serialize. A buffer that
// does not parse never reaches routing — it is a 400 before any handler runs.
function respond(bytes raw): bytes {
    if (var req = Request.parse(raw)) {
        return Routing.handle(req).serialize();
    } else {
        return Routing.badRequest().serialize();
    }
}

// Print the status line + byte count of the response to one canned request (one clean ASCII line).
function summarize(bytes raw): void {
    bytes wire = respond(raw);
    string nl = Bytes.toString(b"\x0d\x0a") ?? "";
    string wireStr = Bytes.toString(wire) ?? "(binary)";
    List<string> lines = String.split(wireStr, nl);
    string statusLine = lines[0];
    int len = Bytes.length(wire);
    Output.printLine("{statusLine} ({len}B)");
}

#[Entry(kind: EntryKind.Cli)]
function main(): void {
    // Exercise the served pipe on five canned requests: a hit per route, an unknown path (404), a
    // method mismatch (404), and a malformed buffer (400) — deterministic, no socket, no File.
    summarize(b"GET / HTTP/1.1\x0d\x0aHost: localhost\x0d\x0a\x0d\x0a");
    summarize(b"GET /greet HTTP/1.1\x0d\x0aHost: phorj.dev\x0d\x0a\x0d\x0a");
    summarize(b"GET /health HTTP/1.1\x0d\x0aHost: localhost\x0d\x0a\x0d\x0a");
    summarize(b"GET /missing HTTP/1.1\x0d\x0aHost: localhost\x0d\x0a\x0d\x0a");
    summarize(b"garbage with no terminator");
}
