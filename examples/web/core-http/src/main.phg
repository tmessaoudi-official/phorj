// Core.Http — the portable HTTP handler model, in the stdlib.
//
// `import Core.Http;` gives you the `Request` and `Response` types with a static-method API —
//   * `Request.parse(bytes) -> Request?`   — parse a raw HTTP/1.1 request (null if malformed)
//   * `req.headers.get(name) -> string?`   — case-insensitive header lookup (rich Request, DEC-331)
//   * `Response.text(status, body)`        — a text/plain response
//   * `resp.serialize() -> bytes`          — render to the HTTP/1.1 wire form
//
// The application is an ordinary `handle(Request) -> Response` function. This file is the CLI
// entry: it drives `handle` over canned requests, so the whole pipeline stays byte-identity-gated
// on both backends AND through real PHP. The SERVED form lives in `../serve.phg` — a `Web` entry
// whose body calls `Http.serve(cfg, handler)` (DEC-331 D5). The two are separate compilation units
// on purpose: `Http.serve` has no faithful PHP mapping (`E-TRANSPILE-SERVE`, Invariant 14), so
// keeping it out of this unit is what lets the logic below keep its PHP leg.
package Main;

import Core.Output;
import Core.Bytes;
import Core.String;
import Core.Http.Request;
import Core.Http.Response;
import Acme.Greeter;
import Core.Runtime.Entry;
import Core.Runtime.EntryKind;

#[Entry(kind: EntryKind.Cli)]
function main(): void {
    string nl = Bytes.toString(b"\x0d\x0a") ?? "";
    // A canonical raw request, built from a `b"…"` literal with explicit CRLFs (deterministic).
    bytes raw = b"GET /hi HTTP/1.1\x0d\x0aHost: localhost\x0d\x0aAccept: text/plain\x0d\x0a\x0d\x0a";
    if (var req = Request.parse(raw)) {
        string m = req.method;
        string p = req.path;
        Output.printLine("method={m} path={p}");
        Output.printLine("host={req.headers.get(\"Host\") ?? \"(none)\"}");
        // Run the handler and serialize the response to the wire form.
        Response resp = Greeter.handle(req);
        bytes wire = resp.serialize();
        int n = Bytes.length(wire);
        // CRLFs shown as " | " so the output stays one clean ASCII line.
        string oneLine = String.replace(Bytes.toString(wire) ?? "", nl, " | ");
        Output.printLine("wire ({n}B): {oneLine}");
    } else {
        Output.printLine("malformed request");
    }
    // A malformed request (no CRLFCRLF head/body boundary) parses to null.
    bytes bad = b"not a request";
    if (var r2 = Request.parse(bad)) {
        Output.printLine("parsed: {r2.method}");
    } else {
        Output.printLine("malformed: yes");
    }
}
