// `Http.ServeConfig` — the web runtime's configuration contract (DEC-331 D4), socket-free.
//
// This is the value `Http.serve(cfg, handler)` is given: one immutable record with a promoted
// constructor, so every field is optional at the call site and NAMED arguments select the ones you
// actually set. `examples/web/{core-http,json-api,server}/serve.phg` each pass one to `Http.serve`;
// here it is only CONSTRUCTED and read, which is what keeps this file byte-identity-gated — a file
// that CALLS `Http.serve` is refused by `phg transpile` (`E-TRANSPILE-SERVE`, Invariant 14 tier 2),
// so the config surface could not otherwise be shown against the PHP leg at all.
//
// Three defaults worth knowing, all visible below:
//   * `workers = 0` means AUTO — one worker per core, resolved by the serve loop. The default is a
//     literal 0 rather than the core count so the class stays a deterministic value: baking a
//     machine-dependent number in would make the two native legs and the PHP leg disagree.
//   * `timeout = 0` means NO timeout, the same sentinel shape.
//   * HTTPS auto-enables **iff BOTH `cert` and `key` are set** (D7) — there is no separate `--tls`
//     flag. As of S3.5 a LONE `cert` (or key) is `E-SERVE-TLS-INCOMPLETE`: `phg serve` refuses to
//     start rather than quietly serving plain HTTP on a port you believe is encrypted. (This line
//     used to say a lone `cert` "is a plain-HTTP one" — that was the reading S3.5 rejected.)
//
// `RequestParsing` (Rich-Request D8a) says WHEN the body is parsed: `Eager` (the default) answers
// 400 at the edge before the handler runs; `Lazy` defers it to first access.
//
// The serve loop READS this (S3.2 Part C, DEC-455.14): a `ServeConfig` passed to `Http.serve` is the
// DEFAULT source for the address, worker count and timeout, so `Http.serve(new ServeConfig(port:
// 3000), h)` binds 3000 with no flags at all. A `phg serve` flag you actually pass, whose value
// differs, WINS — and prints one `W-SERVE-CONFIG-OVERRIDDEN` line naming the field, so an override
// is never silent. A field left at its class default reads as UNSET, because a constructed object
// carries no provenance: `new ServeConfig(timeout: 0)` cannot express "no timeout" (0 is the
// default) — `--timeout 0` is how you say that. `phg explain W-SERVE-CONFIG-OVERRIDDEN`.
//
// Byte-identical on the interpreter, the VM and real PHP.
package Main;

import Core.Output;
import Core.Http;
import Core.Http.ServeConfig;
import Core.Http.RequestParsing;
import Core.Runtime.Entry;
import Core.Runtime.EntryKind;

function parsingName(RequestParsing? p): string {
    if (var parsing = p) {
        return match (parsing) {
            RequestParsing.Eager() => "eager",
            RequestParsing.Lazy() => "lazy"
        };
    }
    return "unset(eager)";
}

// DEC-475: every field is nullable and `null` means UNSET, so these renderers have THREE cases,
// not two — unset (the runtime picks), the sentinel written on purpose, and a real value. That
// difference is the whole point of the ruling: `timeout: 0` means "no timeout" and can finally be
// said, because it is no longer the same thing as not saying anything.
function workersName(int? workers): string {
    if (var w = workers) {
        if (w == 0) {
            return "auto(one per core), written";
        }
        return "{w}";
    }
    return "unset -> auto(one per core)";
}

function timeoutName(int? seconds): string {
    if (var s = seconds) {
        if (s == 0) {
            return "none (no timeout)";
        }
        return "{s}s";
    }
    return "unset -> 30s";
}

// An unset field renders as the effective default the runtime will apply, marked so the reader can
// tell "the program chose this" from "the program said nothing".
function orDefault(string? value, string fallback): string {
    if (var v = value) {
        return v;
    }
    return "unset({fallback})";
}

function intOrDefault(int? value, int fallback): string {
    if (var v = value) {
        return "{v}";
    }
    return "unset({fallback})";
}

// HTTPS is a function of the config, not a flag: BOTH halves present, or plain HTTP.
function scheme(ServeConfig cfg): string {
    if (var c = cfg.cert) {
        if (var k = cfg.key) {
            return "https(min TLS {orDefault(cfg.tlsMinVersion, \"1.2\")})";
        }
    }
    return "http";
}

function describe(string label, ServeConfig cfg): void {
    Output.printLine("{label}:");
    Output.printLine(
        "  bind         {orDefault(cfg.host, \"127.0.0.1\")}:{intOrDefault(cfg.port, 8080)} over {scheme(cfg)}"
    );
    Output.printLine("  workers      {workersName(cfg.workers)}");
    Output.printLine("  timeout      {timeoutName(cfg.timeout)}");
    Output.printLine("  maxBodySize  {intOrDefault(cfg.maxBodySize, 8388608)}");
    Output.printLine("  serverName   {cfg.serverName ?? \"(none)\"}");
    Output.printLine("  parsing      {parsingName(cfg.requestParsing)}");
}

#[Entry(kind: EntryKind.Cli)]
function main(): void {
    // Every field UNSET — what `new ServeConfig()` in a `serve.phg` actually means. Each line says
    // which effective default the runtime will apply, and that the program did not choose it.
    describe("defaults", new ServeConfig());
    // Named arguments select what you set; the rest keep their defaults. Order is free.
    describe("tuned", new ServeConfig(port: 3000, workers: 4, timeout: 30));
    // HTTPS: both halves, so the scheme flips. `serverName` is the virtual host name.
    describe(
        "tls",
        new ServeConfig(
            host: "0.0.0.0",
            port: 8443,
            cert: "certs/site.pem",
            key: "certs/site.key",
            serverName: "example.test",
            tlsMinVersion: "1.3"
        )
    );
    // A LONE `cert` does NOT enable HTTPS — the D7 rule is "iff both". Constructing one is legal
    // (this is a value, not a server), but `phg serve` REFUSES to start on it as of S3.5:
    // `E-SERVE-TLS-INCOMPLETE`. A config that serves plain HTTP while looking encrypted is the
    // footgun worth seeing once, which is why it stays in this example.
    describe("cert-only", new ServeConfig(port: 8443, cert: "certs/site.pem"));
    // Lazy body parsing, and a body cap raised to 32 MiB (the default is 8 MiB).
    describe(
        "lazy-uploads",
        new ServeConfig(maxBodySize: 33554432, requestParsing: new RequestParsing.Lazy())
    );
    // THE case DEC-475 exists for: "no timeout", said out loud. Before the field set became
    // nullable this was byte-for-byte the class default, so it read as unset and the 30s idle guard
    // applied instead — the one thing the field is for could not be expressed.
    describe("no-timeout", new ServeConfig(timeout: 0));
    // And its twin: a value written at the effective default is still a CHOICE. `phg serve` will
    // announce a `--address` flag overriding this one, which it could not do when "set" meant
    // "differs from the default".
    describe("explicit-default-port", new ServeConfig(port: 8080));
    // The value is immutable: reading a field never changes it, so the same instance describes the
    // same server twice. (Withers are a Request affordance; a ServeConfig is built once, at startup.)
    ServeConfig shared = new ServeConfig(port: 9000);
    Output.printLine(
        "re-read       {orDefault(shared.host, \"127.0.0.1\")}:{intOrDefault(shared.port, 8080)} workers={workersName(shared.workers)}"
    );
}
