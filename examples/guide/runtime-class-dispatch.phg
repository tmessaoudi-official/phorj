package Main;

import Core.Output;
import Core.Runtime.Entry;
import Core.Runtime.EntryKind;

// A value typed as a base class still behaves as the class it IS at run time. `with` copies the
// runtime class (the constructor does not run), and a property hook declared by a subclass runs
// even when the value is read or written through the base type.
open class Animal {
    constructor(public mutable string name) {}
    open function kind(): string {
        return "animal";
    }
    function introduce(): string {
        return "I am {this.name}";
    }
}

class Dog extends Animal {
    string name {
        get => "Rex";
        set(string v) {
            Output.printLine("(a dog keeps its name, ignoring {v})");
        }
    }
    function kind(): string {
        return "dog";
    }
}

#[Entry(kind: EntryKind.Cli)]
function main(): void {
    Animal a = new Dog("unused");
    // `with` on a base-typed value keeps the runtime class.
    Animal b = a with { name = "Fido" };
    Output.printLine(b.kind());
    // dog
    // The subclass's hook runs through the base type, including inside a base-class method.
    Output.printLine("{a.name} / {a.introduce()}");
    // Rex / I am Rex
    // A write through the base type runs the subclass's setter.
    a.name = "Max";
    // (a dog keeps its name, ignoring Max)
    Output.printLine(a.name);
}
// Rex
