// #[Entry(kind: …)] (DEC-331) — entries are declared by ATTRIBUTE, never by a magic name, and the
// ROLE is declared, not inferred: `kind: Cli` = the `phg run` entry (`(): void`, `(): int`, or
// `(List<string>): void|int`); `kind: Web` = the `phg serve` handler (`(Request): Response`). One
// of each may coexist. The signature must match the declared kind. An `int` return IS the process
// exit status (0–255); `void` exits 0 on a clean run. Entries may declare `throws` — an escaped
// fault exits 1 (or answers HTTP 500 on the web role).
package Main;

import Core.Output;
import Core.Runtime.Entry;

class App {
    #[Entry(kind: Cli)]
    static function run(): int {
        // The entry can live on a class as a static method — the name is yours to choose.
        Output.printLine("attributed entry, chosen name, int exit");
        return 0;
    }
}
