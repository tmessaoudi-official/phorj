package Main;

import Core.Output;
import Core.Runtime.Entry;
import Core.Runtime.EntryKind;

// Feature B — expression field initializers. PHP restricts property defaults to *constant
// expressions* (no calls, no `$this`, no other-property reads — "Constant expression contains
// invalid operations"). Phorj lifts that: an instance field may be initialized by ANY expression,
// evaluated per-instance at construction in declaration order, after the promoted constructor params
// are bound. An initializer may read `this` and EARLIER-declared sibling fields (a later field is
// `E-FIELD-INIT-FORWARD-REF`). Lowered to a PHP constructor prelude.
function compute(int n): int {
    return n * 10;
}

enum Size { Known(int n), Unknown }

// A match binder may share a LATER field's name: the bare `n` below is the pattern's binding (a bare
// name is never a field read — that would be `this.n`), so this is not a forward reference.
class Crate {
    int area = match (new Size.Known(4)) { Known(n) when n > 0 => n * n, default => 0 };
    int n = 7;
}

function seats(): int {
    return 4;
}

// A CALL to a top-level function named like a later field is a call, not a field read: `seats()`
// below is the function. (A bare VALUE `seats` beside the field would be `E-BARE-FIELD`.)
class Bus {
    int rows = seats() * 2;
    int seats = 40;
}

class Parcel {
    int weight = compute(3) + 1;
    int doubled = this.weight * 2;
    constructor(public string label) {}
    function summary(): string {
        // a call in the default → 31
        // reads `this` + an EARLIER sibling → 62
        return "{this.label}: w={this.weight} d={this.doubled}";
    }
}

#[Entry(kind: EntryKind.Cli)]
function main(): void {
    Parcel t = new Parcel("alpha");
    Output.printLine(t.summary());
    // alpha: w=31 d=62
    Output.printLine("{t.weight + t.doubled}");
    // 93
    Crate c = new Crate();
    Output.printLine("crate: area={c.area} n={c.n}");
    // crate: area=16 n=7
    Bus b = new Bus();
    Output.printLine("bus: rows={b.rows} seats={b.seats}");
}
// bus: rows=8 seats=40
