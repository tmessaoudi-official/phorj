package Main;

// `String.trimAscii` (DEC-545/549) is PHP's own `trim()`: it strips exactly " \t\n\r\0\x0B" from
// both ends and nothing else. `String.trim` is the Unicode-correct one (guide/string-unicode-ws):
// it also strips form feed and U+00A0, which PHP's `trim()` keeps. Both are byte-identical across
// the interpreter, the VM and transpiled PHP; `trimAscii` transpiles to `trim($s)` itself, and
// `phg lift` maps PHP's `trim($s)` onto it.
import Core.Output;
import Core.String;
import Core.Runtime.Entry;
import Core.Runtime.EntryKind;

#[Entry(kind: EntryKind.Cli)]
function main(): void {
    string padded = " \t\r\n  hello  \n";
    Output.printLine("[{padded.trimAscii()}]");
    // A no-break space (U+00A0) is not in PHP's set, so `trimAscii` keeps it; `trim` strips it.
    string nbsp = " word ";
    Output.printLine(
        "trimAscii keeps {String.length(nbsp.trimAscii())} bytes, trim keeps {String.length(nbsp.trim())}"
    );
}
