// Class entry points (Batch-1 D; attribute-declared since DEC-331/DEC-337) — an entry may be a
// class `static` method, not only a top-level function.
//
// The NAME carries no meaning (DEC-415): a free function or a static method is an entry ONLY if it
// is attributed `#[Entry(kind: EntryKind.…)]`. This file is called `class-main` and its method is
// called `main` for historical reasons; either could be named anything. Both shapes are valid
// entries, and the rule is at most ONE ENTRY PER KIND — a second `EntryKind.Cli` anywhere in the
// program is `E-DUPLICATE-ENTRY-KIND` (the older `E-MULTIPLE-MAIN` is retired and never emitted).
// One `Cli` entry and one `Web` entry MAY coexist; `run` and `serve` each take their own.
// A static method has no `this`, so it cannot read instance state — but it may construct the class
// and drive it, which is the idiomatic "the class is the program" shape.
//
// The transpiled PHP bootstraps `App::main()` (vs `\Main\main()` for the top-level form); both
// backends and real PHP are byte-identical, and a `main(): int` return becomes the process exit code.
package Main;

import Core.Output;
import Core.Runtime.Entry;
import Core.Runtime.EntryKind;

class App {
    constructor(public string name) {}
    function greet(): void {
        Output.printLine("Hello from {this.name}");
    }
    #[Entry(kind: EntryKind.Cli)]
    static function main(): int {
        // The Java-style entry: no `this`, returns the exit code. It builds an instance and runs it.
        var app = new App("App.main");
        app.greet();
        Output.printLine("done");
        return 0;
    }
}
