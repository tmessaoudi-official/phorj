// lifted (verify) — a best-effort PHP->Phorj draft; review before trusting it.
package Main;

import Core.Runtime.Entry;
import Core.Runtime.EntryKind;
import Core.Output;

/**
 * @return array{int, string}
 */
function pair(int n): (int, string) {
    return (n, "n={n}");
}

/**
 * @return array{0: float, 1: float}
 */
function origin(): (float, float) {
    return (0.0, 0.0);
}

/**
 * @return array{int, string}|null
 */
function maybePair(bool yes): (int, string)? {
    if (yes) {
        return (1, "one");
    }
    return null;
}

/**
 * @return array{tenure: string, bp: int}
 */
function verdict(string tenure, int bp): (tenure: string, bp: int) {
    return (tenure: tenure, bp: bp);
}

/**
 * @param list<array{tenure: string, bp: int}> $rows
 */
function totalBp(List<(tenure: string, bp: int)> rows): int {
    mutable var n = 0;
    foreach (rows as row) {
        n = n + row.bp;
    }
    return n;
}

#[Entry(kind: EntryKind.Cli)]
function main(): void {
    var (n, label) = pair(7);
    Output.print("{n}");
    Output.print(" ");
    Output.print("{label}");
    Output.print("\n");
    var (x, y) = origin();
    Output.print("{x}");
    Output.print(" ");
    Output.print("{y}");
    Output.print("\n");
    if (maybePair(false) instanceof null) {
        Output.print("none\n");
    } else {
        Output.print("some\n");
    }
    mutable var total = totalBp([verdict("rent", 3), verdict("own", 4)]);
    Output.print("{total}");
    Output.print("\n");
}
