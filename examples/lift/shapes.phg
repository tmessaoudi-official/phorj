// lifted (verify) — a best-effort PHP->Phorj draft; review before trusting it.
package Main;

import Core.Runtime.Entry;
import Core.Runtime.EntryKind;
import Core.Output;
import Core.List;

/**
 * @return array{int, string}
 */
function pair(int n): (int, string) {
    return (n, "n={n}");
}

/**
 * @return array{0: float, 1: float}
 */
function origin(): (float, float) {
    return (0.0, 0.0);
}

/**
 * @return array{int, string}|null
 */
function maybePair(bool yes): (int, string)? {
    if (yes) {
        return (1, "one");
    }
    return null;
}

/**
 * @return array{tenure: string, bp: int}
 */
function verdict(string tenure, int bp): (tenure: string, bp: int) {
    return (tenure: tenure, bp: bp);
}

/**
 * @param list<array{tenure: string, bp: int}> $rows
 */
function totalBp(List<(tenure: string, bp: int)> rows): int {
    mutable var n = 0;
    foreach (rows as row) {
        n = n + row.bp;
    }
    return n;
}

/**
 * A binder over a declared PROPERTY reads the same fields (row 4p).
 */
class Ledger {
    constructor(public mutable List<(tenure: string, bp: int)> rows) {}
    public open function total(): int {
        mutable var n = 0;
        foreach (this.rows as row) {
            n = n + row.bp;
        }
        return n;
    }
    public open function rents(): List<(tenure: string, bp: int)> {
        mutable var out = new List<(tenure: string, bp: int)>();
        foreach (this.rows as row) {
            if (row.tenure == "rent") {
                out = List.append(out, row);
            }
        }
        return out;
    }
    public open function rentBp(): int {
        mutable var n = 0;
        foreach (this.rents() as row) {
            n = n + row.bp;
        }
        return n;
    }
}

/**
 * The builder local of a declared return takes its keyed writes as the declared tuples — each arm
 * of a conditional write too (row 4p).
 *
 * @return array<string, array{tenure: string, bp: int}>
 */
function byTenure(bool owned): Map<string, (tenure: string, bp: int)> {
    mutable var out = new Map<string, (tenure: string, bp: int)>();
    out["rent"] = (tenure: "rent", bp: 3);
    out["own"] = if (owned) { (tenure: "own", bp: 4) } else { (tenure: "own", bp: 0) };
    return out;
}

#[Entry(kind: EntryKind.Cli)]
function main(): void {
    var (n, label) = pair(7);
    Output.print("{n}");
    Output.print(" ");
    Output.print("{label}");
    Output.print("\n");
    var (x, y) = origin();
    Output.print("{x}");
    Output.print(" ");
    Output.print("{y}");
    Output.print("\n");
    if (maybePair(false) instanceof null) {
        Output.print("none\n");
    } else {
        Output.print("some\n");
    }
    mutable var total = totalBp([verdict("rent", 3), verdict("own", 4)]);
    Output.print("{total}");
    Output.print("\n");
    mutable var ledger = new Ledger([verdict("rent", 3), verdict("own", 4)]);
    Output.print("{ledger.total()}");
    Output.print(" ");
    Output.print("{ledger.rentBp()}");
    Output.print("\n");
    foreach (byTenure(true) as tenure => row) {
        // lift: key/value types inferred — spell them out for an explicit header
        Output.print("{tenure}");
        Output.print("=");
        Output.print("{row.bp}");
        Output.print("\n");
    }
}
