// lifted (verify) — a best-effort PHP->Phorj draft; review before trusting it.
package Main;

import Core.Runtime.Entry;
import Core.Runtime.EntryKind;
import Core.Output;
import Core.List;
import Core.Math;
import Core.String;

/**
 * One argument: `min`/`max` take an ARRAY and lift to `xs.min()!` — `!` because an empty list has no
 * minimum (PHP throws `ValueError`; phorj faults on the unwrap).
 *
 * @param list<int> $xs
 */
function spread(List<int> xs): int {
    return xs.max()! - xs.min()!;
}

function clamp(int v, int lo, int hi): int {
    return lo.max(v.min(hi).min(100));
}

function tail(string s, int i): string {
    return s.substring(i, 9223372036854775807);
}

#[Entry(kind: EntryKind.Cli)]
function main(): void {
    Output.print("{spread([4, 1, 7])}");
    Output.print("|");
    Output.print("{clamp(250, 0, 150)}");
    Output.print("|");
    Output.print("{clamp(-5, 0, 150)}");
    Output.print("|");
    Output.print("{tail(\"hello\", 1)}");
    Output.print("|");
    Output.print("{tail(\"hello\", -2)}");
    Output.print("\n");
}
