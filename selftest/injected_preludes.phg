// Injected-prelude symbols are testable — the regression guard for KNOWN_ISSUES §TEST-RAW-CHECKER.
//
// `phg test` used to run the RAW checker: no prelude injection, no intrinsic/variant import
// resolution, no DI/Db desugar. Every symbol that exists only in an injected prelude was therefore
// reported as the user's own `E-UNKNOWN-IDENT`, and the first one cascaded into three more messages
// that all blamed this file. A program `phg check` and `phg run` both accepted simply could not be
// tested, and the report pointed at the wrong thing.
//
// The runner now shares the same front end as `phg check` and the LSP (DEC-252's chokepoint), so
// this file is a real assertion about that: every `import` below reaches a type that exists only
// because a prelude was injected. If the runner is ever re-pointed at the raw checker, these stop
// compiling under `phg test` — which is what `tests/mtest.rs` pins.
//
// NOTE, corrected 2026-09-02: an earlier version of this comment said such a file would "still pass
// `phg check`". It would not, and neither does this one — `phg check` rejects a `test` item outright
// with `E-TEST-OUTSIDE-TESTS`, so the property as written was unverifiable. That asymmetry is itself
// an open gap: the LSP runs the same non-test path, so this file squiggles in both editors on lines
// `phg test` accepts (KNOWN_ISSUES §TEST-RAW-CHECKER).
package Main;

import Core.Test;
import Core.Http;
import Core.Http.ServeConfig;
import Core.Http.Response;
import Core.Option;
import Core.Option.Some;

test "the injected ServeConfig carries its ruled defaults" {
    ServeConfig fresh = new ServeConfig();
    Test.assertEquals(fresh.host, "127.0.0.1");
    Test.assertEquals(fresh.port, 8080);
    // `timeout = 0` is the literal "no timeout" sentinel, not an unset field.
    Test.assertEquals(fresh.timeout, 0);
}

test "named arguments select what a ServeConfig sets" {
    ServeConfig tuned = new ServeConfig(port: 3000, workers: 4);
    Test.assertEquals(tuned.port, 3000);
    Test.assertEquals(tuned.workers, 4);
    // Unnamed fields keep their defaults.
    Test.assertEquals(tuned.host, "127.0.0.1");
}

test "an injected Response builds and reports its status" {
    Response ok = Response.text(200, "ok");
    Test.assertEquals(ok.status, 200);
}

// CD-31: this is the arm the milestone panel actually reported, and it is the one the differential
// cannot reach — a `test` body only exists under `phg test`. `resolve_variant_imports` is an
// ITEM-level walk that ended in `other => other`, so an imported variant used inside a test body was
// never rewritten to its qualified form and failed with `E-INJECTED-VARIANT-BARE` — while the
// byte-identical body inside `function main()` resolved fine. Stub the `Item::Test` arm back out and
// this test stops compiling.
test "an imported variant resolves inside a test body, as it does in a function" {
    Option<int> wrapped = new Some(3);
    match (wrapped) {
        Option.Some(v) => Test.assertEquals(v, 3),
        Option.None() => Test.assertEquals(0, 1)
    };
}
// NOT tested here, and the reason is worth recording: `EntryKind` is injected only as the
// ATTRIBUTE-argument surface for `#[Entry(kind:)]`, not as a general value type, so
// `EntryKind web = EntryKind.Web;` is `E-UNKNOWN-TYPE` — under `phg check` AND under `phg test`,
// identically. That agreement is the property this file guards; it just happens to be visible on a
// rejection rather than an acceptance.
